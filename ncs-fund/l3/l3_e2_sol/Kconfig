source "Kconfig.zephyr"

# STEP 6 - Define a custom Kconfig for enabling myfunction
# define the configuration CONFIG_MYFUNCTION as a boolean variable and sets its default value to n.
config MYFUNCTION
	bool "Enable my function"
	default n